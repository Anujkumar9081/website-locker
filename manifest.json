{
  "manifest_version": 3,
  "name": "Website Locker",
  "version": "1.0.0",
  "description": "Lock specific website URLs with unique passwords.",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "webNavigation",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}

